# Port du serveur de dev/preview Vite (réservé via MasterEnv, série portail QVL après 3000/3001).
# Lu par vite.config.ts (loadEnv), fallback 3002 si absent. À surcharger si un
# service local (ex. API Chabé sur 3002/3005/3011/3012) occupe déjà le port.
PROJECTCENTER_PORT=3002

# Source des documentations distantes (fetch runtime via l'API GitLab v4).
# ProjectCenter construit les URLs raw ainsi :
#   {VITE_DOCS_API_PROJECT_URL}/repository/files/{chemin encodé}/raw?ref={VITE_DOCS_REF}
# Repo doc : MartinQueval/QVL-Documentation (projet 84403403), public depuis le 2026-07-16.
# API v4 = CORS `*` vérifié ; ne PAS utiliser la route web /-/raw/ (pas de CORS).
# Voir docs/decisions/docs-source-gitlab-api.md.
VITE_DOCS_API_PROJECT_URL=https://gitlab.com/api/v4/projects/84403403
VITE_DOCS_REF=main
