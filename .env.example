# Port du serveur de dev/preview Vite (réservé via MasterEnv, série portail QVL après 3000/3001).
# Lu par vite.config.ts (loadEnv), fallback 3002 si absent. À surcharger si un
# service local (ex. API Chabé sur 3002/3005/3011/3012) occupe déjà le port.
PROJECTCENTER_PORT=3002

# Base des documentations distantes (fetch runtime: VITE_DOCS_BASE_URL + docPath).
# Source figée par le spike CORS de l'US0 (SCRUM-312) : miroir GitHub raw public de Documentation.
# Voir docs/decisions/cors-docs-source.md.
VITE_DOCS_BASE_URL=https://raw.githubusercontent.com/QVL-Studio/Documentation/main/
